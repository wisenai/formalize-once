# Reproducing the paper needs NONE of this: `python reproduce.py` reads the stored
# result records and never calls a model. These matter only for a live re-run.

# Required to spend money at all. Without it, every paid call is refused with an
# explanatory error, so a probe script run out of curiosity costs nothing.
SSCRAMBLE_ALLOW_SPEND=

# All five models in the paper were run through OpenRouter.
OPENROUTER_API_KEY=sk-or-...

# Only if you point a model at Anthropic's API directly instead of OpenRouter
# (src/symbol_scramble/llm/client.py raises if this is unset on that path).
ANTHROPIC_API_KEY=

# Only for RuleArena's own vendored tax evaluator
# (data/raw/rulearena/tax/micro_evaluation.py), which is not used by our pipeline.
OPENAI_API_KEY=
